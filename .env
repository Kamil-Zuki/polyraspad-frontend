# API: BFF AggregatorService
# Локально (run-bff-with-deps.ps1 / dotnet run): порт 5206
# Docker Compose: хост-порт 5000 -> см. docker-compose.yml (aggregator-service)
NEXT_PUBLIC_API_URL=https://api.polyraspad.online

# Публичный URL фронта (metadataBase, редиректы). Локальный dev Next.js — обычно 3000
NEXT_PUBLIC_APP_URL=https://app.polyraspad.online

# Ollama для /editor (серверные маршруты /api/ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8B

# Gemini отключён: только локальная Ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EDITOR_AI_PROVIDER=ollama
