# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BFF → Aggregator /api/ai/* (должен совпадать с Ai:ProxyApiKey; в Dev Aggregator см. appsettings.Development.json)
AI_PROXY_API_KEY=

# Внутренний URL Aggregator для серверных маршрутов Next (Docker: http://aggregator-service:5206)
# AGGREGATOR_INTERNAL_URL=http://127.0.0.1:5000

# Модель для UI редактора (если Aggregator разрешает override)
# NEXT_PUBLIC_EDITOR_AI_MODEL=gpt-4o-mini

# Gemini (опционально): ключ на сервере Next
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# gemini | aggregator — gemini при GEMINI_API_KEY; иначе маршруты /api/ai/* → Aggregator (нужен AI_PROXY_API_KEY)
EDITOR_AI_PROVIDER=aggregator

# Feature Flags (MVP)
NEXT_PUBLIC_FF_AI_AGENTS=false
NEXT_PUBLIC_FF_ADVANCED_MODULES=false
