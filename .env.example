# API Configuration
# URL РІР°С€РµРіРѕ Aggregator Service API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application URL
# РСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РґР»СЏ metadata Рё redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ollama (AI Assistant на /editor — маршруты Next /api/ollama/*)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=<your_ollama_model_name>
# Прокси через Aggregator: тот же ключ, что Ollama:ProxyApiKey (в Development по умолчанию dev-ollama-proxy-shared-secret)
OLLAMA_PROXY_API_KEY=
# Серверный URL Aggregator (в Docker: http://aggregator-service:5206; локально часто http://127.0.0.1:5000)
# AGGREGATOR_INTERNAL_URL=http://127.0.0.1:5000
# Опционально: переопределить только для клиента редактора
# NEXT_PUBLIC_EDITOR_OLLAMA_MODEL=<your_ollama_model_name>

# Gemini (опционально): ключ на сервере Next. Без ключа держите EDITOR_AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# ollama | auto | gemini — ollama: только локальная модель; auto: при наличии ключа Gemini
EDITOR_AI_PROVIDER=ollama
