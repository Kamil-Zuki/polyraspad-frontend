# API Configuration
# URL РІР°С€РµРіРѕ Aggregator Service API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application URL
# РСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РґР»СЏ metadata Рё redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ollama (AI Assistant на /editor — маршруты Next /api/ollama/*)
# Дефолт: qwen2.5:1.5b (меньше qwen3.5:2b, pull: ollama pull qwen2.5:1.5b)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# Опционально: переопределить только для клиента редактора
# NEXT_PUBLIC_EDITOR_OLLAMA_MODEL=qwen2.5:1.5b

# Gemini (опционально): ключ на сервере Next. Без ключа держите EDITOR_AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# ollama | auto | gemini — ollama: только локальная модель; auto: при наличии ключа Gemini
EDITOR_AI_PROVIDER=ollama
